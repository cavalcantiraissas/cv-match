# Copie para .env (na pasta cv-match/) e ajuste. Todas as variáveis são opcionais.

# --- IA generativa (opcional) ---------------------------------------------
# auto: usa o Gemini se GEMINI_API_KEY estiver definida; senão, o modo local (regras).
AI_PROVIDER=auto
# Chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
AI_TIMEOUT_SECONDS=60

# --- Análise semântica ------------------------------------------------------
# auto: usa Sentence Transformers se estiver instalado (requirements-semantic.txt); senão, TF-IDF.
SEMANTIC_BACKEND=auto
SEMANTIC_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Limites e privacidade ----------------------------------------------------
MAX_PDF_MB=5
MAX_PDF_PAGES=10
MAX_JOB_CHARS=20000
# Currículos enviados e nunca analisados são apagados após este prazo.
RESUME_TTL_HOURS=24

# --- Infraestrutura -------------------------------------------------------------
# Padrão: backend/cv_match.db
# DATABASE_URL=sqlite:////caminho/absoluto/cv_match.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
